# Google service account (same project as portfolio-manager) — used to read/write the
# "Sam's Portfolio Manager" Sheet. Either point to a credentials file or paste base64 JSON.
GOOGLE_CREDENTIALS_PATH=
# GOOGLE_SERVICE_ACCOUNT=<base64-encoded service account JSON>

# Shared Upstash Redis instance (same as Jordan/Aide) — used to look up the cached
# spreadsheet ID written by portfolio-manager.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk auth for this dashboard. Use a separate Clerk application from Aide.ai.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Comma-separated emails that may use FundManager controls when Clerk publicMetadata.role is FundManager.
FUND_MANAGER_EMAILS=

# Audit row signing secret. Generate a long random value and keep it server-side only.
AUDIT_HMAC_SECRET=

# Required for manager-only research and agent chat generation.
ANTHROPIC_API_KEY=
